{
  "name": "pdfmason",
  "version": "0.0.0",
  "private": true,
  "description": "PDFrig — Build better PDFs.",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/prepare-local-ocr-assets.mjs && turbo run build",
    "build:packages": "pnpm --filter \"./packages/**\" --if-present build",
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "brand:check": "node --test scripts/brand-assets.test.mjs",
    "beta:economics": "node scripts/check-beta-economics.mjs",
    "beta:readiness": "pnpm build:packages && node scripts/check-beta-readiness.mjs",
    "beta:release-gate": "pnpm build:packages && node scripts/check-beta-economics.mjs --require-measured && node scripts/check-beta-readiness.mjs --public-release",
    "check": "pnpm repo:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:component && pnpm desktop:surface-check && pnpm license:check && pnpm secret:scan && pnpm beta:economics && pnpm beta:readiness && pnpm build",
    "db:start": "pnpm --filter @pdfmason/db db:start",
    "db:stop": "pnpm --filter @pdfmason/db db:stop",
    "db:advisors": "pnpm --filter @pdfmason/db db:advisors",
    "db:test": "pnpm --filter @pdfmason/db db:test",
    "desktop:dev": "node scripts/prepare-local-ocr-assets.mjs && pnpm build:packages && pnpm --filter @pdfmason/desktop tauri:dev",
    "desktop:internal-build": "node scripts/build-internal-windows.mjs",
    "desktop:notices": "node scripts/prepare-desktop-notices.mjs",
    "desktop:surface-check": "node scripts/check-tauri-surface.mjs",
    "desktop:release-config": "node scripts/create-tauri-release-config.mjs",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "license:check": "node scripts/check-licenses.mjs",
    "license:check:cargo": "node scripts/check-cargo-licenses.mjs",
    "license:notices:windows": "node scripts/verify-windows-npm-notices.mjs",
    "lint": "pnpm build:packages && eslint . --max-warnings 0",
    "repo:check": "node scripts/check-repository-hygiene.mjs",
    "repo:history": "node scripts/audit-repository-history.mjs",
    "secret:scan": "node scripts/check-sensitive-files.mjs",
    "security:audit": "pnpm audit --prod --audit-level high",
    "test": "node --test scripts/workspace-scripts.test.mjs scripts/db-concurrency-session.test.mjs scripts/check-browser-verifiers.test.mjs scripts/brand-assets.test.mjs scripts/source-text-evaluation-policy.test.mjs scripts/release-documentation.test.mjs scripts/repository-hygiene.test.mjs scripts/local-ocr-assets.test.mjs scripts/desktop-license-texts.test.mjs scripts/npm-notice-evidence.test.mjs scripts/ocr-node-fetch.test.mjs scripts/windows-pe-assets.test.mjs && turbo run test",
    "test:browser": "playwright test",
    "test:db-concurrency": "node scripts/test-db-concurrency.mjs",
    "test:component": "pnpm build:packages && pnpm --filter @pdfmason/ui test:component",
    "test:office-worker": "node scripts/test-office-worker.mjs",
    "test:ocr-worker": "node scripts/test-ocr-worker.mjs",
    "test:pdf-corpus": "pnpm build:packages && node scripts/verify-pdf-corpus.mjs",
    "test:pdf-decorations": "pnpm build:packages && node scripts/verify-pdf-decorations.mjs",
    "test:pdf-parser-security": "pnpm build:packages && node --test scripts/measure-pdf-parser-security.test.mjs && node scripts/measure-pdf-parser-security.mjs --output tmp/parser-security/report.json",
    "test:pdf-utilities": "pnpm build:packages && node scripts/verify-pdf-utilities.mjs",
    "test:pdf-permissions": "pnpm build:packages && node scripts/verify-pdf-permissions.mjs",
    "test:local-text": "pnpm build:packages && node scripts/verify-local-text.mjs",
    "typecheck": "turbo run typecheck",
    "web:dev": "node scripts/prepare-local-ocr-assets.mjs && pnpm build:packages && pnpm --filter @pdfmason/web dev",
    "worker:dev": "pnpm build:packages && pnpm --filter @pdfmason/worker dev"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.0.0",
    "prettier": "3.9.6",
    "supabase": "2.121.0",
    "tsx": "4.23.12",
    "turbo": "2.10.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
