# Safe public browser configuration. These placeholders are intentionally non-secret.
# Local QA only: dedicated Playwright port (1024–65535); never reuses a running preview.
# PDFMASON_BROWSER_TEST_PORT=3100
# Playwright sets PDFMASON_BROWSER_TEST_ISOLATION=1 internally for a separate .next-qa cache.
# Do not set it for a normal preview, type-generation command, or production build.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=0.0.0-local
NEXT_PUBLIC_ANALYTICS_ENABLED=true
NEXT_PUBLIC_BETA_INTAKE_ENABLED=true
NEXT_PUBLIC_BRAND_DOMAIN=localhost
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.invalid
NEXT_PUBLIC_LEGAL_ENTITY=PDFrig development
NEXT_PUBLIC_PRIVACY_CONTACT=privacy@example.invalid
NEXT_PUBLIC_POLICY_STATUS=development-draft
NEXT_PUBLIC_POLICY_EFFECTIVE_DATE=2026-08-24
NEXT_PUBLIC_PROCESSING_LOCATION=Local development only; production regions are not approved.
NEXT_PUBLIC_PRICING_STATUS=provisional
NEXT_PUBLIC_PLAN_CURRENCY=CAD
NEXT_PUBLIC_PLAN_PRO_MONTHLY_MINOR=699
NEXT_PUBLIC_PLAN_PRO_ANNUAL_MINOR=5999
NEXT_PUBLIC_REFUND_SUMMARY=Development placeholder: refund eligibility and required consumer-law disclosures need approval before payment is enabled.
NEXT_PUBLIC_TEMPORARY_OUTPUT_HOURS=1
NEXT_PUBLIC_STORAGE_SAFETY_NET_HOURS=24
NEXT_PUBLIC_HISTORY_RETENTION_DAYS=30
# NEXT_PUBLIC_STATUS_PAGE_URL=
NEXT_PUBLIC_FEATURE_BLANK_ENABLED=true
# CONV-005 bounded plain-text conversion; keep disabled for unapproved releases.
NEXT_PUBLIC_FEATURE_TEXT_ENABLED=false
NEXT_PUBLIC_FEATURE_TABLES_ENABLED=false
# SEC-003: development controls only; production and distribution remain gated.
NEXT_PUBLIC_FEATURE_PERMISSIONS_ENABLED=false
NEXT_PUBLIC_FEATURE_COMPRESS_ENABLED=true
NEXT_PUBLIC_FEATURE_COMMENT_REVIEW_ENABLED=true
NEXT_PUBLIC_FEATURE_MEASUREMENT_ENABLED=true
NEXT_PUBLIC_FEATURE_DECORATE_ENABLED=true
NEXT_PUBLIC_FEATURE_GEOMETRY_ENABLED=true
NEXT_PUBLIC_FEATURE_IMAGES_ENABLED=true
NEXT_PUBLIC_FEATURE_METADATA_ENABLED=true
NEXT_PUBLIC_FEATURE_NUMBERING_ENABLED=true
NEXT_PUBLIC_FEATURE_OCR_ENABLED=false
NEXT_PUBLIC_FEATURE_PROTECT_ENABLED=true
NEXT_PUBLIC_FEATURE_REDACTION_ENABLED=false
NEXT_PUBLIC_FEATURE_STAMPS_ENABLED=true
VITE_PDFMASON_REDACTION_ENABLED=false
VITE_PDFMASON_COMMENT_REVIEW_ENABLED=true
VITE_PDFMASON_MEASUREMENT_ENABLED=true
VITE_PDFMASON_STAMPS_ENABLED=true
VITE_PDFMASON_TEXT_ENABLED=false
VITE_PDFMASON_TABLES_ENABLED=false
VITE_PDFMASON_OCR_ENABLED=false
VITE_PDFMASON_PERMISSIONS_ENABLED=false
VITE_PDFMASON_ENTITLEMENT_ENFORCED=false
# Optional Windows account session. Values are public client configuration; never use a secret key.
# VITE_SUPABASE_URL=http://127.0.0.1:55321
# VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_PDFMASON_WEB_URL=http://127.0.0.1:3000
# Public Ed25519 verification material for signed desktop entitlement snapshots.
# VITE_PDFMASON_ENTITLEMENT_KEY_ID=
# VITE_PDFMASON_ENTITLEMENT_PUBLIC_KEY=  # Base64 SPKI DER
NEXT_PUBLIC_FEATURE_RENDER_ENABLED=true

# Local development defaults to deterministic in-memory providers and needs no credentials.
PDFMASON_PROVIDER_MODE=fake
PDFMASON_ANALYTICS_MODE=fake
PDFMASON_BETA_INTAKE_MODE=fake
PDFMASON_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
PDFMASON_PROCESSING_REGION=local-development
PDFMASON_OUTPUT_RETENTION_HOURS=1
PDFMASON_STORAGE_SAFETY_NET_HOURS=24
PDFMASON_HISTORY_RETENTION_DAYS=30
PDFMASON_OFFICE_CONVERSION_ENABLED=false
PDFMASON_OFFICE_EXPANDED_LIMIT_BYTES=250000000
PDFMASON_OFFICE_INPUT_LIMIT_BYTES=50000000
PDFMASON_OFFICE_JOB_TIMEOUT_SECONDS=120
PDFMASON_OFFICE_OUTPUT_LIMIT_BYTES=200000000
PDFMASON_OCR_ENABLED=false
PDFMASON_OCR_INPUT_LIMIT_BYTES=50000000
PDFMASON_OCR_LANGUAGES=eng,fra
PDFMASON_OCR_MAXIMUM_PAGES=50
PDFMASON_OCR_MAXIMUM_PIXELS=20000000
PDFMASON_OCR_OUTPUT_LIMIT_BYTES=200000000
PDFMASON_OCR_TIMEOUT_SECONDS=180
PDFMASON_STORAGE_GRANT_SECONDS=300
WORKER_HOST=127.0.0.1
WORKER_PORT=8787
WORKER_LEASE_SECONDS=60
WORKER_POLL_INTERVAL_MS=1000

# Production-only browser authentication. Copy these names to an ignored local file and add real values.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Production-only trusted provider configuration. Never expose these names through NEXT_PUBLIC_*.
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
# PDFMASON_DESKTOP_ENTITLEMENT_KEY_ID=
# PDFMASON_DESKTOP_ENTITLEMENT_PRIVATE_KEY=  # Base64 PKCS#8 DER; secret
# PDFMASON_DESKTOP_ENTITLEMENT_TTL_HOURS=24
# PDFMASON_DESKTOP_ENTITLEMENT_GRACE_HOURS=168
# PDFMASON_R2_ACCOUNT_ID=
# PDFMASON_R2_ACCESS_KEY_ID=
# PDFMASON_R2_SECRET_ACCESS_KEY=
# PDFMASON_R2_BUCKET=
# PDFMASON_STRIPE_RESTRICTED_KEY=
# PDFMASON_STRIPE_WEBHOOK_SECRET=
# PDFMASON_STRIPE_PRICE_PRO_MONTHLY=
# PDFMASON_STRIPE_PRICE_PRO_ANNUAL=

# Protected Windows release-build configuration. Never commit key or certificate material.
# PDFMASON_RELEASE_CHANNEL=alpha
# PDFMASON_RELEASE_VERSION=0.1.0-alpha.1
# PDFMASON_UPDATER_ENDPOINT=https://updates.example.invalid/alpha/{{target}}/{{arch}}/{{current_version}}
# PDFMASON_UPDATER_PUBLIC_KEY=
# PDFMASON_WINDOWS_CERTIFICATE_THUMBPRINT=
# PDFMASON_WINDOWS_TIMESTAMP_URL=
# PDFMASON_WINDOWS_PUBLISHER=
# PDFMASON_DESKTOP_IDENTIFIER=com.pdfmason.desktop
