{
  "name": "@pdfmason/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --exclude \"src/*.component.test.tsx\" --passWithNoTests",
    "test:component": "vitest run .component.test.tsx",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@pdfmason/editor-core": "workspace:*",
    "@pdfmason/pdf-engine": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "happy-dom": "20.11.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
